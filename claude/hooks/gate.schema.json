{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/claude-action.schema.json",
  "title": "Claude Code test-gate action config",
  "description": "各プロジェクトの .claude/gate.yaml のスキーマ。変更ファイルのパスに glob マッチするルールごとに、実行ディレクトリとコマンド列を定義する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "description": "上から順に評価され、マッチした全ルールが実行される（早期終了しない）。",
      "items": {
        "$ref": "#/definitions/rule"
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "run"
      ],
      "properties": {
        "match": {
          "description": "変更ファイルのパスに対する glob パターン（プロジェクトルートからの相対パス基準）。* は / を跨がない、** は跨ぐ、{a,b} でブレース展開可能。文字列1つ、または複数パターンのリストを指定できる。",
          "oneOf": [
            {
              "$ref": "#/definitions/globPattern"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/globPattern"
              }
            }
          ]
        },
        "dir": {
          "type": "string",
          "description": "run のコマンドを実行する作業ディレクトリ（プロジェクトルートからの相対パス）。省略時はプロジェクトルートで実行される。",
          "minLength": 1,
          "not": {
            "pattern": "(^/|\\.\\.(/|$))"
          }
        },
        "run": {
          "type": "array",
          "description": "マッチしたときに順番に実行するシェルコマンド列。1つでも非0で終了すれば、このルールは失敗とみなされる。",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "globPattern": {
      "type": "string",
      "minLength": 1
    }
  }
}
